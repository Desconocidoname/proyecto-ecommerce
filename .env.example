# ============================================================
# Variables de entorno de ejemplo.
# Copia este archivo:  cp .env.example .env
# Llena .env con los valores reales. .env NUNCA se sube a Git.
# ============================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=churn
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=churn
DATABASE_URL=postgresql://churn:cambia_esta_contrasena@db:5432/churn

# --- Servicio de IA ---
ML_SERVICE_URL=http://ml-service:8000
MODEL_DIR=/models
ALERT_THRESHOLD=0.42

# --- Acceso del administrador (RF-07) ---
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_contrasena
# Genera uno propio con:  openssl rand -hex 32
SESSION_SECRET=genera_un_valor_aleatorio_largo

# --- Cupones (RF-06) ---
COUPON_PREFIX=VUELVE
COUPON_DISCOUNTS=10,15,20
# Dirección de la página pública del cupón (ruta /cupon/ del frontend).
# El QR lleva a esta dirección + el código. Para escanearlo con un celular
# conectado a la misma red Wi-Fi, usa la IP de tu computadora en lugar de
# localhost (la ves con:  ip -4 addr | grep inet), por ejemplo:
#   COUPON_PUBLIC_URL=http://192.168.1.50:3000/cupon/
COUPON_PUBLIC_URL=http://localhost:3000/cupon/

# --- Predicción masiva (RF-08) ---
# true: al arrancar, el backend calcula el riesgo de los 50,000 clientes si no
# hay predicciones o si el modelo se reentrenó.
PREDICT_ON_START=true
