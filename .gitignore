# Secretos
.env
.env.*
!.env.example

# Entorno de Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Datos: el CSV original SÍ se versiona (reproducibilidad, Entrega 3);
# los datos procesados se regeneran con preparar_datos.py.
data/raw/*
!data/raw/.gitkeep
!data/raw/customers.csv
data/processed/*
!data/processed/.gitkeep

# Modelos: se versionan los artefactos del entrenamiento (Entrega 3).
ml/models/*
!ml/models/.gitkeep
!ml/models/*.joblib
!ml/models/metadata.json
!ml/models/experimentos.csv
!ml/models/*.png

# Node
node_modules/
dist/
npm-debug.log*

